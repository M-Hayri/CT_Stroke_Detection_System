@model BTİNME.Models.Doktor

@{
    Layout = null; // Login ekranında üst navbar/footer görünmesin
    ViewData["Title"] = "Giriş Yap | İNME Teşhis Sistemi";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background: linear-gradient(135deg, #0b1e36 0%, #1e3a5f 50%, #0d253f 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
            width: 100%;
            max-width: 440px;
            padding: 35px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        /* LOGO ALANI DÜZENLEMESİ */
        .logo-box {
            width: 130px;
            height: 130px;
            margin: 0 auto 15px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #ffffff;
            padding: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            border: 1px solid #eef2f7;
        }

        .logo-img {
            width: 100%;
            height: 100%;
            object-fit: contain; /* Görseli kesmeden/kırmadan kutuya sığdırır */
            border-radius: 50%; /* Logo dairesel olduğu için kutuyla uyumlu olsun */
            transition: transform 0.3s ease;
        }

            .logo-img:hover {
                transform: scale(1.04);
            }

        .form-control {
            border-radius: 12px;
            padding: 12px 15px 12px 45px;
            border: 1.5px solid #e2e8f0;
            font-size: 0.95rem;
            background-color: #f8fafc;
            transition: all 0.2s ease;
        }

            .form-control:focus {
                background-color: #fff;
                border-color: #0d6efd;
                box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.15);
            }

        .input-icon-group {
            position: relative;
        }

            .input-icon-group i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #64748b;
                font-size: 1.1rem;
                z-index: 10;
            }

        .btn-login {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            border: none;
            border-radius: 12px;
            padding: 13px;
            font-weight: 600;
            font-size: 1rem;
            letter-spacing: 0.5px;
            box-shadow: 0 8px 20px rgba(13, 110, 253, 0.3);
            transition: all 0.3s ease;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 24px rgba(13, 110, 253, 0.4);
                background: linear-gradient(135deg, #0b5ed7 0%, #084298 100%);
            }

        .system-badge {
            background-color: rgba(13, 110, 253, 0.08);
            color: #0d6efd;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 1px;
            padding: 5px 14px;
            border-radius: 20px;
            text-transform: uppercase;
        }
    </style>
</head>
<body>

    <div class="login-card text-center">
        <!-- ORTALANMIŞ LOGO -->
        <div class="logo-box">
            <img src="~/images/LOGO.jpeg" alt="İnme Teşhis Sistemi Logo" class="logo-img" />
        </div>

        <div class="mb-3">
            <span class="system-badge"><i class="bi bi-person-badge-fill me-1"></i> Hekim Portalı</span>
        </div>

        <!-- ALT BAŞLIK -->
        <p class="text-muted small mb-4">Lütfen sisteme erişmek için bilgilerinizi giriniz.</p>

        <!-- HATA MESAJI (VARSA) -->
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 rounded-3 small py-2 mb-3 text-start d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
                <div>@ViewBag.Error</div>
            </div>
        }

        <!-- GİRİŞ FORMU -->
        <form asp-action="Login" method="post">

            <!-- TC KIMLIK NO -->
            <div class="mb-3 input-icon-group text-start">
                <i class="bi bi-card-heading"></i>
                <input type="text" name="tc" class="form-control" placeholder="TC Kimlik Numarası" maxlength="11" required autocomplete="off" />
            </div>

            <!-- ŞİFRE -->
            <div class="mb-4 input-icon-group text-start">
                <i class="bi bi-lock-fill"></i>
                <input type="password" name="sifre" class="form-control" placeholder="Şifre" required />
            </div>

            <!-- GİRİŞ BUTONU -->
            <button type="submit" class="btn btn-primary w-100 btn-login mb-3">
                <i class="bi bi-box-arrow-in-right me-2"></i> Sisteme Giriş Yap
            </button>

        </form>

        <div class="mt-4 pt-3 border-top">
            <small class="text-muted" style="font-size: 0.75rem;">
                <i class="bi bi-shield-check me-1"></i>Klinik Karar Destek Sistemi
            </small>
        </div>
    </div>

</body>
</html>